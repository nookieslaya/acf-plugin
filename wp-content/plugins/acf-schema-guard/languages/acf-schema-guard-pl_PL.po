msgid "ACF Schema Guard"
msgstr "ACF Schema Guard"

#. Description of the plugin
#: acf-schema-guard.php
msgid ""
"Detects potentially breaking Advanced Custom Fields schema changes before "
"deployment."
msgstr "Wykrywa potencjalnie niebezpieczne zmiany w strukturze pól ACF przed wdrożeniem."

#: includes/admin/class-admin-controller.php:28
msgid "Overview"
msgstr "Przegląd"

#: includes/admin/class-admin-controller.php:28
msgid "A starting point for reviewing ACF schema safety."
msgstr "Punkt wyjścia do sprawdzenia bezpieczeństwa struktury ACF."

#: includes/admin/class-admin-controller.php:29
msgid "Changes"
msgstr "Zmiany"

#: includes/admin/class-admin-controller.php:29
msgid "Schema changes will appear here after a comparison is run."
msgstr "Zmiany w strukturze pojawią się tutaj po wykonaniu porównania."

#: includes/admin/class-admin-controller.php:30
msgid "Field Groups"
msgstr "Grupy pól"

#: includes/admin/class-admin-controller.php:30
msgid "Normalized field groups will appear here in a later feature."
msgstr "Ujednolicone grupy pól pojawią się tutaj w późniejszej wersji."

#: includes/admin/class-admin-controller.php:31
msgid "Code Usage"
msgstr "Użycie w kodzie"

#: includes/admin/class-admin-controller.php:31
msgid "References found by supported code scanners will appear here."
msgstr "Wykryte odwołania do pól w kodzie pojawią się tutaj."

#: includes/admin/class-admin-controller.php:32
msgid "Unused Fields"
msgstr "Nieużywane pola"

#: includes/admin/class-admin-controller.php:32
msgid "Review-only PHP coverage signals for current ACF fields."
msgstr "Informacje pomocnicze o użyciu bieżących pól ACF w kodzie PHP."

#: includes/admin/class-admin-controller.php:33
msgid "History"
msgstr "Historia"

#: includes/admin/class-admin-controller.php:33
msgid "Captured schema snapshots will appear here in a later feature."
msgstr "Zapisane migawki struktury pojawią się tutaj w późniejszej wersji."

#: includes/admin/class-admin-controller.php:34
msgid "Settings"
msgstr "Ustawienia"

#: includes/admin/class-admin-controller.php:34
msgid "Configuration controls will appear here when settings are supported."
msgstr "Opcje konfiguracji pojawią się tutaj, gdy zostaną udostępnione."

#: includes/admin/class-admin-controller.php:167
msgid "You do not have permission to access this page."
msgstr "Nie masz uprawnień do wyświetlenia tej strony."

#: includes/admin/class-admin-controller.php:174
msgid "The requested ACF Schema Guard page is not available."
msgstr "Żądana strona ACF Schema Guard jest niedostępna."

#: includes/admin/class-admin-controller.php:215
msgid "This read-only section has no data or actions available yet."
msgstr "Ta sekcja jest obecnie tylko do odczytu i nie zawiera jeszcze danych ani dostępnych działań."

#: includes/admin/class-admin-controller.php:235
msgid ""
"Review the current ACF schema safety posture, then continue with the "
"workflow that needs attention."
msgstr "Sprawdź aktualny stan bezpieczeństwa struktury ACF, a następnie przejdź do obszaru wymagającego uwagi."

