"This ACF structure does not have a storage pattern the plugin can verify "
"safely."
msgstr ""
"Ta struktura ACF nie ma sposobu zapisu, który wtyczka może bezpiecznie "
"zweryfikować."

#: includes/admin/class-admin-controller.php:1619
msgid "Direct storage"
msgstr "Bezpośredni zapis"

#: includes/admin/class-admin-controller.php:1620
