msgstr "Przełącz na podgląd Pro"

#: includes/admin/class-admin-controller.php:378
msgid "Baseline needed"
msgstr "Wymagana wersja bazowa"

#: includes/admin/class-admin-controller.php:379
msgid ""
"Choose a stored snapshot as the approved baseline before reviewing live "
"changes."
msgstr "Przed sprawdzaniem bieżących zmian wybierz zapisaną migawkę jako zatwierdzoną wersję bazową."

#: includes/admin/class-admin-controller.php:385
msgid "Baseline approved"
msgstr "Wersja bazowa zatwierdzona"

#: includes/admin/class-admin-controller.php:386
#, php-format
msgid "Captured %s."
msgstr "Zapisano %s."

#: includes/admin/class-admin-controller.php:400
msgid "Comparison unavailable"
msgstr "Porównanie niedostępne"

#: includes/admin/class-admin-controller.php:401
msgid "A live schema comparison is not available yet."
msgstr "Porównanie z bieżącą strukturą nie jest jeszcze dostępne."

#: includes/admin/class-admin-controller.php:420
msgid "Review required"
msgstr "Wymagane sprawdzenie"

#: includes/admin/class-admin-controller.php:420
msgid "No high-risk changes"
msgstr "Brak zmian wysokiego ryzyka"

#: includes/admin/class-admin-controller.php:421
