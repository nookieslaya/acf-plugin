msgid "%d schema finding detected."
msgid_plural "%d schema findings detected."
msgstr[0] "%d wykryta zmiana w strukturze."
msgstr[1] "%d wykryte zmiany w strukturze."
msgstr[2] "%d wykrytych zmian w strukturze."

#: includes/admin/class-admin-controller.php:436
#: includes/admin/class-admin-controller.php:831
msgid "Source health unavailable"
msgstr "Stan źródeł niedostępny"

#: includes/admin/class-admin-controller.php:437
msgid "ACF Local JSON could not be inspected."
msgstr "Nie udało się sprawdzić ACF Local JSON."

#: includes/admin/class-admin-controller.php:442
#: includes/admin/class-admin-controller.php:828
msgid "Database-first mode"
msgstr "Tryb oparty na bazie danych"

#: includes/admin/class-admin-controller.php:442
msgid ""
"Local JSON is not configured. Baseline, Changes, Code Usage, and data impact "
"remain available."
msgstr "Local JSON nie jest skonfigurowany. Wersja bazowa, zmiany, użycie w kodzie i analiza wpływu na dane nadal są dostępne."

#: includes/admin/class-admin-controller.php:455
msgid "Source review needed"
msgstr "Wymagane sprawdzenie źródeł"

#: includes/admin/class-admin-controller.php:455
msgid "Sources aligned"
msgstr "Źródła są zgodne"

#: includes/admin/class-admin-controller.php:456
#, php-format
msgid "%d field group needs source review."
msgid_plural "%d field groups need source review."
msgstr[0] "%d grupa pól wymaga sprawdzenia źródeł."
msgstr[1] "%d grupy pól wymagają sprawdzenia źródeł."
msgstr[2] "%d grup pól wymaga sprawdzenia źródeł."

#: includes/admin/class-admin-controller.php:462
#, php-format
msgid "Theme: %s"
msgstr "Motyw: %s"

#: includes/admin/class-admin-controller.php:464
#, php-format
msgid "Plugin: %s"
msgstr "Wtyczka: %s"

#: includes/admin/class-admin-controller.php:471
msgid "You do not have permission to update scanner settings."
msgstr "Nie masz uprawnień do zmiany ustawień skanera."

#: includes/admin/class-admin-controller.php:480
msgid "You do not have permission to update risk policy."
msgstr "Nie masz uprawnień do zmiany zasad ryzyka."

#: includes/admin/class-admin-controller.php:488
msgid "You do not have permission to change edition preview."
msgstr "Nie masz uprawnień do zmiany podglądu wersji."

#: includes/admin/class-admin-controller.php:495
msgid "You do not have permission to export risk policy."
msgstr "Nie masz uprawnień do eksportu zasad ryzyka."

#: includes/admin/class-admin-controller.php:501
msgid "You do not have permission to approve exceptions."
msgstr "Nie masz uprawnień do zatwierdzania wyjątków."

#: includes/admin/class-admin-controller.php:507
msgid ""
"This exception could not be saved. Check the reason, expiry, and Pro access."
msgstr "Nie udało się zapisać wyjątku. Sprawdź powód, datę wygaśnięcia i dostęp do wersji Pro."

#: includes/admin/class-admin-controller.php:512
msgid "You do not have permission to revoke exceptions."
msgstr "Nie masz uprawnień do wycofywania wyjątków."

#: includes/admin/class-admin-controller.php:520
msgid "You do not have permission to download release reports."
msgstr "Nie masz uprawnień do pobierania raportów wydania."

#: includes/admin/class-admin-controller.php:523
msgid "An approved baseline is required before exporting a report."
msgstr "Przed eksportem raportu wymagana jest zatwierdzona wersja bazowa."

#: includes/admin/class-admin-controller.php:556
msgid ""
"Literal PHP ACF references found in the configured themes and plugins as "
"they exist now. Each field groups all of its real call sites together."
msgstr "Bezpośrednie odwołania do pól ACF znalezione w aktualnym kodzie wybranych motywów i wtyczek. Dla każdego pola pokazane są wszystkie wykryte miejsca użycia."

#: includes/admin/class-admin-controller.php:560
#: includes/admin/class-admin-controller.php:672
msgid "Field"
msgstr "Pole"

#: includes/admin/class-admin-controller.php:562
#: includes/admin/class-admin-controller.php:672
msgid "All fields"
msgstr "Wszystkie pola"

#: includes/admin/class-admin-controller.php:568
msgid "File"
msgstr "Plik"

#: includes/admin/class-admin-controller.php:570
msgid "All files"
msgstr "Wszystkie pliki"

#: includes/admin/class-admin-controller.php:576
msgid "ACF function"
msgstr "Funkcja ACF"

#: includes/admin/class-admin-controller.php:578
msgid "All supported functions"
msgstr "Wszystkie obsługiwane funkcje"

#: includes/admin/class-admin-controller.php:584
msgid "Filter references"
msgstr "Filtruj odwołania"

#: includes/admin/class-admin-controller.php:588
#, php-format
msgid "%d reference shown"
msgid_plural "%d references shown"
msgstr[0] "Wyświetlono %d odwołanie."
msgstr[1] "Wyświetlono %d odwołania."
msgstr[2] "Wyświetlono %d odwołań."

#: includes/admin/class-admin-controller.php:595
msgid "No matching references"
msgstr "Brak pasujących odwołań"

#: includes/admin/class-admin-controller.php:596
msgid ""
"Try changing the filters, or choose source roots in Settings before scanning "
"again."
msgstr "Zmień filtry albo wybierz katalogi do skanowania w Ustawieniach i uruchom skanowanie ponownie."

#: includes/admin/class-admin-controller.php:605
#, php-format
msgid "%d reference"
msgid_plural "%d references"
msgstr[0] "%d odwołanie"
msgstr[1] "%d odwołania"
msgstr[2] "%d odwołań"

#: includes/admin/class-admin-controller.php:607
msgid "Show call sites"
msgstr "Pokaż miejsca użycia"

#: includes/admin/class-admin-controller.php:615
msgid "PHP context around this call."
msgstr "Fragment kodu PHP wokół tego wywołania."

#: includes/admin/class-admin-controller.php:671
msgid ""
"This workspace is in development. It complements Code Usage by starting with "
"ACF fields that have no detected literal PHP reference. Review dynamic "
"calls, unscanned code, and stored data before making any schema decision."
msgstr "Ta sekcja jest w trakcie rozwoju. Uzupełnia analizę użycia w kodzie, pokazując pola ACF bez wykrytych bezpośrednich odwołań w PHP. Przed zmianą struktury sprawdź także wywołania dynamiczne, nieskanowany kod i zapisane dane."

#: includes/admin/class-admin-controller.php:672
msgid ""
"These are review signals from configured PHP scanner roots. They never mean "
"a field is safe to delete."
msgstr "To są jedynie wskazówki na podstawie skonfigurowanego skanowania PHP. Brak odwołań nigdy nie oznacza automatycznie, że pole można bezpiecznie usunąć."

#: includes/admin/class-admin-controller.php:672
msgid "Review state"
msgstr "Stan weryfikacji"

#: includes/admin/class-admin-controller.php:672
msgid "Potentially unused"
msgstr "Potencjalnie nieużywane"

#: includes/admin/class-admin-controller.php:672
#: includes/admin/class-admin-controller.php:758
msgid "Manual review required"
msgstr "Wymagana ręczna weryfikacja"

#: includes/admin/class-admin-controller.php:672
msgid "Filter fields"
msgstr "Filtruj pola"

#: includes/admin/class-admin-controller.php:672
msgid "No fields available for review"
msgstr "Brak pól do sprawdzenia"

#: includes/admin/class-admin-controller.php:672
msgid ""
"Confirm that ACF field groups and scanner roots are available, then scan "
"again."
msgstr "Sprawdź, czy grupy pól ACF i katalogi do skanowania są dostępne, a następnie uruchom skanowanie ponownie."

#: includes/admin/class-admin-controller.php:672
msgid "Literal references"
msgstr "Bezpośrednie odwołania"

#: includes/admin/class-admin-controller.php:672
msgid "State"
msgstr "Stan"

#: includes/admin/class-admin-controller.php:754
msgid "Dynamic ACF calls need manual review"
msgstr "Dynamiczne wywołania ACF wymagają ręcznej weryfikacji"

#: includes/admin/class-admin-controller.php:755
msgid ""
"These supported calls use a non-literal field argument. ACF Schema Guard "
"cannot safely determine which field they access, so they are not linked to a "
"specific schema change."
msgstr "Te wywołania używają dynamicznie określonej nazwy pola. ACF Schema Guard nie może jednoznacznie ustalić, do którego pola się odwołują, dlatego nie są przypisywane do konkretnej zmiany struktury."

#: includes/admin/class-admin-controller.php:782
#: includes/admin/class-admin-controller.php:856
msgid "Unknown"
msgstr "Nieznany"

#: includes/admin/class-admin-controller.php:795
#: includes/admin/class-admin-controller.php:800
msgid "Source preview is unavailable."
msgstr "Podgląd źródła jest niedostępny."

#: includes/admin/class-admin-controller.php:826
msgid ""
"Your ACF schema is managed in the WordPress database. Local JSON comparison "
"is optional and is not required for schema safety."
msgstr "Struktura ACF jest zarządzana w bazie danych WordPressa. Porównanie z Local JSON jest opcjonalne i nie jest wymagane do kontroli bezpieczeństwa struktury."

#: includes/admin/class-admin-controller.php:826
msgid ""
"Checks whether each ACF field group is represented consistently in the "
"WordPress database and ACF Local JSON."
msgstr "Sprawdza, czy każda grupa pól ACF jest zgodna w bazie danych WordPressa i w ACF Local JSON."

#: includes/admin/class-admin-controller.php:828
msgid ""
"ACF Local JSON is not configured. This is a supported workflow: set an "
"approved baseline, review live Changes, and use Code Usage to check current "
"PHP references."
msgstr "ACF Local JSON nie jest skonfigurowany. Ten sposób pracy jest obsługiwany: ustaw zatwierdzoną wersję bazową, sprawdzaj bieżące zmiany i używaj analizy kodu do kontroli odwołań w PHP."

#: includes/admin/class-admin-controller.php:832
msgid "ACF is unavailable, so Source health cannot inspect field groups."
msgstr "ACF jest niedostępny, dlatego nie można sprawdzić stanu źródeł grup pól."

#: includes/admin/class-admin-controller.php:836
msgid "No field groups found"
msgstr "Nie znaleziono grup pól"

#: includes/admin/class-admin-controller.php:837
msgid ""
"No ACF field groups were found in the database or configured Local JSON "
"paths."
msgstr "Nie znaleziono grup pól ACF w bazie danych ani w skonfigurowanych ścieżkach Local JSON."

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Field group"
msgstr "Grupa pól"

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Key"
msgstr "Klucz"

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Status"
msgstr "Status"

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Database"
msgstr "Baza danych"

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Local JSON"
msgstr "Local JSON"

#: includes/admin/class-admin-controller.php:841
#: includes/admin/class-admin-controller.php:842
msgid "Recommended action"
msgstr "Zalecane działanie"

#: includes/admin/class-admin-controller.php:861
msgid "Missing"
msgstr "Brak"

#: includes/admin/class-admin-controller.php:861
msgid "Not found"
msgstr "Nie znaleziono"

#: includes/admin/class-admin-controller.php:865
#: includes/admin/class-admin-controller.php:869
#: includes/admin/class-admin-controller.php:873
#: includes/admin/class-admin-controller.php:876
msgid "Present"
msgstr "Dostępne"

#: includes/admin/class-admin-controller.php:865
msgid "Matches"
msgstr "Zgodne"

#: includes/admin/class-admin-controller.php:869
msgid "Same modified time"
msgstr "Ten sam czas modyfikacji"

#: includes/admin/class-admin-controller.php:873
msgid "Newer schema"
msgstr "Nowsza struktura"

#: includes/admin/class-admin-controller.php:876
msgid "Review"
msgstr "Sprawdź"

#: includes/admin/class-admin-controller.php:883
#: includes/admin/class-admin-controller.php:892
msgid "No action needed."
msgstr "Nie jest wymagane żadne działanie."

#: includes/admin/class-admin-controller.php:887
msgid ""
"Definitions differ but timestamps are equal. ACF Sync may not be available."
msgstr "Definicje różnią się, ale mają ten sam czas modyfikacji. Synchronizacja ACF może być niedostępna."

#: includes/admin/class-admin-controller.php:890
msgid ""
"Local JSON is newer. Review it, then use ACF Sync to import it into the "
"database."
msgstr "Local JSON jest nowszy. Sprawdź zmiany, a następnie użyj synchronizacji ACF, aby zaimportować je do bazy danych."

#: includes/admin/class-admin-controller.php:891
msgid ""
"The database is newer. Open this group in ACF and save it to refresh Local "
"JSON before committing."
msgstr "Wersja w bazie danych jest nowsza. Otwórz tę grupę w ACF i zapisz ją, aby zaktualizować Local JSON przed commitem."

#: includes/admin/class-admin-controller.php:892
msgid ""
"Save or sync this group so it is written to Local JSON and committed to Git."
msgstr "Zapisz lub zsynchronizuj tę grupę, aby trafiła do Local JSON i mogła zostać dodana do Gita."

#: includes/admin/class-admin-controller.php:892
msgid ""
"Review the JSON definition and import or sync it into the database when "
"appropriate."
msgstr "Sprawdź definicję JSON i w razie potrzeby zaimportuj lub zsynchronizuj ją z bazą danych."

