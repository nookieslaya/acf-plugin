#: includes/admin/class-admin-controller.php:336
msgid "Save scanner roots"
msgstr "Zapisz zakres skanowania"

#: includes/admin/class-admin-controller.php:342
msgid "Release policy"
msgstr "Zasady wydania"

#: includes/admin/class-admin-controller.php:342
msgid "Risk threshold"
msgstr "Próg ryzyka"

#: includes/admin/class-admin-controller.php:342
msgid "Choose the lowest severity that blocks a release check."
msgstr "Wybierz najniższy poziom ryzyka, który ma blokować kontrolę przed wydaniem."

#: includes/admin/class-admin-controller.php:343
msgid "Team policy active"
msgstr "Aktywne zasady zespołu"

#: includes/admin/class-admin-controller.php:343
#, php-format
msgid ""
"The repository file %1$s sets the active %2$s threshold. It takes priority "
"over this site's local setting."
msgstr "Plik %1$s w repozytorium ustawia aktywny próg %2$s. Ma on pierwszeństwo przed lokalnym ustawieniem tej witryny."

#: includes/admin/class-admin-controller.php:344
msgid "Save risk policy"
msgstr "Zapisz zasady ryzyka"

#: includes/admin/class-admin-controller.php:344
